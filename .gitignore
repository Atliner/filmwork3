# Local deployment state and credentials; never commit these.
node_modules/
.wrangler/
.env
.env.*
.dev.vars
.dev.vars.*
# NOTE: wrangler.toml IS committed on purpose — Cloudflare Workers Builds
# (git-based deploys) reads bindings/vars from it. Keep tokens OUT of it and
# store them as dashboard Secrets instead. KV/D1 IDs are not secret.
*.log

# Database exports can contain users and secrets
filmwork-kv-backup*.json
*.sqlite
*.sqlite3

# Local Node/shared-hosting runtime data (SQLite + compiled copy of worker.js)
hosting/data/
hosting/config.local.json

# Capacitor / Android build outputs
app/android/
app/www/config.js
app/.capacitor/

# Electron build outputs
app/desktop/release/
app/desktop/dist/
